{
  "name": "pty-tech-repair-ai",
  "version": "1.0.0",
  "description": "PTY-TECH Repair AI desktop app",
  "main": "main.js",
  "author": "PTY-TECH",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ptytech.repairai",
    "productName": "PTY-TECH Repair AI",
    "files": ["main.js", "public/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "artifactName": "PTY-TECH-Repair-AI-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
